# Silicon Labs Project Configuration Tools: slcp, v0, Component selection file.
project_name: pts_bg24_capture
label: PTS Phase2 BG24 PRS Timer Capture
description: |
  Precision Time Sync POC Phase 2 — BG24 captures Si917 BLE-event GPIO via
  async PRS into TIMER0, then associates delayed PTS2 host frames with R[N].
category: Example|Platform
package: platform
quality: evaluation
readme:
- path: README.md
source:
- path: app.c
- path: pts_prs_timer_capture.c
- path: pts_host_rx.c
include:
- path: .
  file_list:
  - path: app.h
  - path: pts_prs_timer_capture.h
  - path: pts_host_rx.h
- path: ../common
  file_list:
  - path: pts_event_ref_protocol.h
sdk:
  vendor: silabs
  id: simplicity_sdk
  version: 2026.6.1
toolchain_settings: [
  ]
component:
- package: simplicity_sdk
  vendor: silabs
  id: EFR32MG24B220F1536IM48
- package: simplicity_sdk
  vendor: silabs
  id: brd4002a
- package: simplicity_sdk
  vendor: silabs
  id: brd4187c
- package: simplicity_sdk
  vendor: silabs
  id: clock_manager
- package: simplicity_sdk
  vendor: silabs
  id: device_init
- package: simplicity_sdk
  vendor: silabs
  id: emlib_gpio
- package: simplicity_sdk
  vendor: silabs
  id: emlib_prs
- package: simplicity_sdk
  vendor: silabs
  id: emlib_timer
- package: simplicity_sdk
  vendor: silabs
  id: emlib_usart
- package: simplicity_sdk
  vendor: silabs
  id: iostream
- package: simplicity_sdk
  vendor: silabs
  id: iostream_recommended_stream
- package: simplicity_sdk
  instance:
  - vcom
  vendor: silabs
  id: iostream_eusart
- package: simplicity_sdk
  vendor: silabs
